NODE_ENV=development
PORT=4000

# MongoDB Atlas (region UE)
MONGODB_URI=mongodb://localhost:27017/plateforme-dev

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Front autorise pour CORS
APP_ORIGIN=http://localhost:5173
VITRINE_ORIGIN=http://localhost:4321

# Vercel Deploy Hook de la vitrine (Project Settings > Git > Deploy Hooks) : declenche un
# redeploy de la vitrine statique des qu'une formule est creee/modifiee/archivee. Sans cette
# valeur, l'appel est seulement journalise (voir deployHook.service.ts).
VITRINE_DEPLOY_HOOK_URL=

# Reservation : duree de blocage d'une place en minutes (regle metier n°2)
BOOKING_HOLD_DURATION_MINUTES=15
# Tache planifiee de liberation des reservations expirees (format cron)
BOOKING_EXPIRATION_CRON=*/1 * * * *
# Report/annulation gratuits jusqu'a N jours avant le debut du stage (CGV)
CANCELLATION_FREE_DAYS_BEFORE_START=7

# Stripe (Lot 2) - cles de test, jamais les cles live en dev/preprod
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/paiement/succes
STRIPE_CANCEL_URL=http://localhost:5173/paiement/annule

# Alma (paiement en plusieurs fois), derriere un drapeau tant que non integre
ALMA_ENABLED=false

# Stockage fichiers prives (Lot 2) - Cloudflare R2 (compatible S3) ou Amazon S3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Emails / SMS (Lot 4) - sans cle, les notifications sont seulement journalisees (voir notification.service.ts)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=NAVETTE
BREVO_SMS_SENDER=NAVETTE
