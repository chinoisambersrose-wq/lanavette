NODE_ENV=development
PORT=4000

# MongoDB Atlas (region UE)
MONGODB_URI=mongodb://localhost:27017/plateforme-dev

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Front autorise pour CORS
APP_ORIGIN=http://localhost:5173
VITRINE_ORIGIN=http://localhost:4321

# Reservation : duree de blocage d'une place en minutes (regle metier n°2)
BOOKING_HOLD_DURATION_MINUTES=15

# Stripe (Lot 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stockage fichiers (Lot 2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Emails / SMS (Lot 4)
BREVO_API_KEY=
