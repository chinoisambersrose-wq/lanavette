---
import FaqAccordion from '../components/FaqAccordion.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const items = [
  {
    question: 'Comment réserver un stage ?',
    reponse:
      'Choisissez une formule, consultez les dates disponibles, puis contactez-nous sur WhatsApp ou Snapchat pour confirmer votre inscription.',
  },
  {
    question: 'Quels documents dois-je fournir ?',
    reponse:
      "Une pièce d'identité, un justificatif de domicile, une photo ePhoto et une attestation ASSR si nécessaire.",
  },
  {
    question: 'Puis-je payer en plusieurs fois ?',
    reponse: 'Oui, selon les conditions en vigueur au moment de votre inscription.',
  },
  {
    question: 'Le CPF peut-il financer mon stage ?',
    reponse:
      "Sous certaines conditions, oui. Voir notre page Financement pour les étapes à suivre et contactez-nous pour vérifier l'éligibilité de votre formule.",
  },
  {
    question: "Que se passe-t-il si je ne suis pas prêt le jour de l'examen ?",
    reponse:
      "Votre moniteur vous donne un avis avant l'examen. En cas de besoin, l'équipe vous recontacte pour ajuster votre stage.",
  },
  {
    question: 'Comment annuler ou reporter ma réservation ?',
    reponse:
      'Contactez-nous directement sur WhatsApp ou Snapchat, selon les délais prévus dans nos conditions générales de vente.',
  },
  {
    question: 'Quelle est la différence entre boîte manuelle et automatique ?',
    reponse:
      "La boîte automatique simplifie la conduite (pas d'embrayage) et convient bien pour un apprentissage rapide. La boîte manuelle reste le choix le plus polyvalent, valable pour tous les véhicules.",
  },
  {
    question: 'La conduite accompagnée, à partir de quel âge ?',
    reponse: "Dès 15 ans, avec un rendez-vous préalable obligatoire avant le début de l'apprentissage.",
  },
  {
    question: "Le prix inclut-il les frais d'examen ?",
    reponse: "Le prix affiché inclut la formation et la place d'examen garantie, sauf mention contraire sur la formule.",
  },
  {
    question: 'Dans quelles villes intervenez-vous ?',
    reponse:
      "Retrouvez la liste de nos villes desservies sur la page d'accueil. Contactez-nous si votre ville n'y figure pas encore.",
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.reponse },
    })),
  },
];
---

<BaseLayout
  title="FAQ — NAVETTE"
  description="Les réponses aux questions fréquentes sur la réservation, le paiement et le déroulement du stage de permis accéléré."
  structuredData={structuredData}
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="mb-6 text-3xl font-semibold text-white">Questions fréquentes</h1>
    <FaqAccordion items={items} />
  </section>
</BaseLayout>
