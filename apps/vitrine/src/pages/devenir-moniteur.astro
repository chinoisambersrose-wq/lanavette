---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Devenir moniteur — NAVETTE"
  description="Rejoignez notre équipe de moniteurs : candidature en ligne."
>
  <section class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-semibold text-white">Devenir moniteur</h1>
    <p class="mt-3 text-slate-300">
      Vous êtes enseignant de la conduite (BEPECASER ou titre professionnel équivalent) ?
      Rejoignez notre équipe.
    </p>

    <form id="candidature-form" class="mt-8 space-y-4 rounded-xl border border-slate-800 bg-slate-900 p-6">
      <div class="grid grid-cols-2 gap-4">
        <label class="text-sm text-slate-300">
          Prénom
          <input
            required
            name="prenom"
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-white"
          />
        </label>
        <label class="text-sm text-slate-300">
          Nom
          <input
            required
            name="nom"
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-white"
          />
        </label>
      </div>
      <label class="block text-sm text-slate-300">
        Email
        <input
          required
          type="email"
          name="email"
          class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-white"
        />
      </label>
      <label class="block text-sm text-slate-300">
        Téléphone
        <input
          required
          name="telephone"
          class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-white"
        />
      </label>
      <label class="block text-sm text-slate-300">
        Message (expérience, ville souhaitée...)
        <textarea
          name="message"
          rows="4"
          class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-white"
        />
      </label>

      <button type="submit" class="rounded-lg bg-white px-5 py-2 font-medium text-slate-900 transition-colors hover:bg-slate-200">
        Envoyer ma candidature
      </button>

      <p id="candidature-confirmation" class="hidden rounded-lg bg-green-500/10 p-3 text-sm text-green-400">
        Merci, votre candidature a été enregistrée. Notre équipe vous recontacte rapidement.
      </p>
    </form>
  </section>
</BaseLayout>

<script>
  // Formulaire statique de demonstration : aucune API de recrutement n'existe encore cote back-office.
  // A connecter a une vraie route (ex. POST /api/v1/candidatures) ou a un service d'emailing avant mise en prod.
  const form = document.getElementById('candidature-form');
  const confirmation = document.getElementById('candidature-confirmation');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    confirmation?.classList.remove('hidden');
    (form as HTMLFormElement).reset();
  });
</script>
