---
import FormulaCard from '../components/FormulaCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFormulas } from '../lib/api.js';

const formulas = await getFormulas();
const stagesVoiture = formulas.filter((f) => f.categorie === 'voiture');
const stagesAac = formulas.filter((f) => f.categorie === 'conduite_accompagnee');

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: "Combien de temps dure l'examen du permis B ?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "L'examen pratique du permis B dure environ 32 minutes, dont 25 minutes de conduite effective.",
        },
      },
    ],
  },
];
---

<BaseLayout
  title="Permis B accéléré — NAVETTE"
  description="Stage de permis B en accéléré : nos formules, le choix boîte automatique ou manuelle, notre méthode et la conduite accompagnée."
  structuredData={structuredData}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-semibold text-slate-900">Permis B accéléré</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Le permis B reste le permis le plus demandé en France. Avec NAVETTE, vous passez votre
      permis voiture en quelques jours plutôt qu'en plusieurs mois, avec un moniteur unique et une
      date d'examen connue avant de payer.
    </p>
  </section>

  <section id="stages" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-10">
    <h2 class="text-2xl font-semibold text-slate-900">Nos stages accélérés</h2>
    <p class="mt-2 max-w-2xl text-slate-600">
      Boîte manuelle ou automatique, avec ou sans conduite accompagnée préalable : choisissez la
      formule qui correspond à votre niveau.
    </p>
    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
      {stagesVoiture.map((formula) => <FormulaCard formula={formula} />)}
    </div>
  </section>

  <section id="boite-automatique" class="mx-auto max-w-4xl scroll-mt-20 px-4 py-10">
    <h2 class="text-2xl font-semibold text-slate-900">Permis boîte automatique</h2>
    <p class="mt-2 text-slate-600">
      La boîte automatique simplifie l'apprentissage : moins de manipulations, plus de
      concentration sur la circulation. Nos stages en boîte automatique suivent la même méthode
      que nos stages en boîte manuelle.
    </p>
    <a href="/permis-automatique/" class="mt-3 inline-block font-medium text-indigo-600 hover:underline">
      Voir les formules boîte automatique →
    </a>
  </section>

  <section id="methode" class="bg-slate-950 py-12 text-white">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="text-2xl font-semibold">Notre méthode</h2>
      <p class="mt-2 text-slate-300">
        Un moniteur unique du début à la fin, un planning connu avant de payer, une date d'examen
        garantie par un créneau réservé à l'avance. Pas de surprise, pas d'attente.
      </p>
      <a href="/methode/" class="mt-3 inline-block font-medium text-indigo-400 hover:underline">
        Découvrir notre méthode en détail →
      </a>
    </div>
  </section>

  <section id="examen" class="mx-auto max-w-4xl scroll-mt-20 px-4 py-10">
    <h2 class="text-2xl font-semibold text-slate-900">Examen du permis B</h2>
    <p class="mt-2 text-slate-600">
      L'examen pratique dure environ 32 minutes, dont 25 minutes de conduite effective. L'examinateur
      évalue la prise d'information, la maîtrise du véhicule et le partage de la route avec les
      autres usagers. Chez NAVETTE, votre session est rattachée à un créneau d'examen réservé à
      l'avance : vous connaissez votre date avant même de payer.
    </p>
  </section>

  <section id="aac" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-10">
    <h2 class="text-2xl font-semibold text-slate-900">Conduite accompagnée (AAC)</h2>
    <p class="mt-2 max-w-2xl text-slate-600">
      Dès 15 ans, la conduite accompagnée permet d'accumuler de l'expérience avant l'examen, avec
      un accompagnateur. Un parcours progressif, encadré par le même moniteur tout au long du
      stage.
    </p>
    {
      stagesAac.length > 0 ? (
        <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
          {stagesAac.map((formula) => <FormulaCard formula={formula} />)}
        </div>
      ) : (
        <p class="mt-4 text-sm text-slate-500">Aucune formule AAC disponible pour le moment.</p>
      )
    }
  </section>
</BaseLayout>
