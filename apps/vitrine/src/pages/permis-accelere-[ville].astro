---
import FormulaCard from '../components/FormulaCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCities, getFormulas, getMeetingPoints } from '../lib/api.js';
import type { City, MeetingPoint } from '../lib/api.js';

export async function getStaticPaths() {
  const cities = await getCities();
  const paths = [];

  for (const city of cities) {
    paths.push({
      params: { ville: city.slug },
      props: { city, meetingPoints: await getMeetingPoints(city.slug) },
    });
  }

  return paths;
}

interface Props {
  city: City;
  meetingPoints: MeetingPoint[];
}

const { city, meetingPoints } = Astro.props;
const formulas = await getFormulas();

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: `NAVETTE — ${city.nom}`,
    address: { '@type': 'PostalAddress', addressLocality: city.nom, addressCountry: 'FR' },
  },
];
---

<BaseLayout
  title={`Permis accéléré à ${city.nom} — NAVETTE`}
  description={`Stages de permis accéléré à ${city.nom} : points de rendez-vous, formules disponibles et prochaines sessions.`}
  structuredData={structuredData}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-semibold text-white">Permis accéléré à {city.nom}</h1>

    <h2 class="mt-8 text-xl font-semibold text-white">Points de rendez-vous</h2>
    {
      meetingPoints.length > 0 ? (
        <ul class="mt-3 space-y-2 text-slate-300">
          {meetingPoints.map((point) => (
            <li class="rounded-lg border border-slate-800 bg-slate-900 p-3">
              <p class="font-medium text-white">{point.nom}</p>
              <p class="text-sm">{point.adresse}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-3 text-slate-400">Points de rendez-vous à venir pour cette ville.</p>
      )
    }

    <h2 class="mt-10 text-xl font-semibold text-white">Formules disponibles</h2>
    <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
      {formulas.map((formula) => <FormulaCard formula={formula} />)}
    </div>
  </section>
</BaseLayout>
