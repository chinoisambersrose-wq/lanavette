---
import FormulaCard from '../components/FormulaCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFormulas } from '../lib/api.js';

const formulas = (await getFormulas()).filter((f) => f.boite === 'manuelle');
---

<BaseLayout
  title="Permis manuel en accéléré — [NOM]"
  description="Formules de permis accéléré en boîte manuelle : prix, durée et dates disponibles."
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-800">Permis manuel</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      La boîte manuelle reste le choix le plus polyvalent : elle permet de conduire tous les
      véhicules. Nos formules en boîte manuelle :
    </p>

    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
      {formulas.map((formula) => <FormulaCard formula={formula} />)}
    </div>
  </section>
</BaseLayout>
