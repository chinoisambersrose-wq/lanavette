---
import AdvicePreview from '../components/AdvicePreview.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import ContactBand from '../components/ContactBand.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
import FormulaCard from '../components/FormulaCard.astro';
import PhotoHighlights from '../components/PhotoHighlights.astro';
import TestimonialBlock from '../components/TestimonialBlock.astro';
import TrustStats from '../components/TrustStats.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCities, getFormulas } from '../lib/api.js';

const formulas = await getFormulas();
const cities = await getCities();

const categories = [
  { key: 'voiture', label: 'Voiture' },
  { key: 'conduite_accompagnee', label: 'Conduite accompagnée' },
  { key: 'moto', label: 'Moto' },
  { key: 'code', label: 'Code' },
  { key: 'poids_lourd', label: 'Poids lourd' },
] as const;

const faqItems = [
  {
    question: 'Combien de temps avant de passer l\'examen ?',
    reponse:
      'Le délai dépend du centre d\'examen et de la formule choisie. La date vous est communiquée.',
  },
  {
    question: 'Puis-je changer de date après ma réservation ?',
    reponse:
      'Un report est possible selon les conditions générales de vente, dans un délai à respecter avant le début du stage.',
  },
  {
    question: 'Le prix inclut-il les frais d\'examen ?',
    reponse: 'Le prix affiché inclut la formation et la place d\'examen garantie.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'DrivingSchool',
    name: 'NAVETTE',
    description: "Plateforme d'auto-école spécialisée dans le permis en accéléré.",
    url: Astro.site?.toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.reponse },
    })),
  },
];
---

<BaseLayout
  title="NAVETTE — Permis en accéléré, dates et moniteur garantis avant de payer"
  description="Réservez votre stage de permis en accéléré : vous connaissez vos dates, votre moniteur et votre date d'examen avant de payer."
  structuredData={structuredData}
>
  <section
    class="relative flex min-h-[28rem] items-center justify-center bg-cover bg-center px-4 py-24 text-center md:min-h-[36rem]"
    style="background-image: url('/hero.jpg');"
  >
    <div class="absolute inset-0 bg-slate-950/60" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-2xl">
      <h1 class="text-4xl font-semibold text-white drop-shadow md:text-6xl">
        Passez votre permis en 2 semaines 🚀
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-slate-100 drop-shadow">
        Créée en 2018, La Navette est la seule auto-école qui vous permet d'obtenir votre permis de conduire en 14 jours
        <strong>avant</strong>100% garantie.
      </p>
      <a
        href="#formules"
        class="mt-6 inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-900 shadow-lg transition-transform hover:scale-[1.02]"
      >
        Voir les disponibilités
      </a>
    </div>
  </section>

  <TrustStats />

  <section id="formules" class="mx-auto max-w-6xl px-4 pb-16 scroll-mt-20">
    <div class="mb-6 flex justify-center gap-2" id="category-tabs">
      {
        categories.map((cat, i) => (
          <button
            type="button"
            data-category={cat.key}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-medium transition-colors',
              i === 0
                ? 'bg-indigo-600 text-white'
                : 'border border-slate-200 bg-white text-slate-600',
            ]}
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        formulas.map((formula) => (
          <div data-category-item={formula.categorie} style={formula.categorie !== 'voiture' ? 'display:none' : undefined}>
            <FormulaCard formula={formula} />
          </div>
        ))
      }
    </div>

    <script>
      const tabs = document.querySelectorAll<HTMLButtonElement>('#category-tabs button');
      const items = document.querySelectorAll<HTMLElement>('[data-category-item]');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => t.classList.remove('bg-indigo-600', 'text-white'));
          tabs.forEach((t) => t.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-600'));
          tab.classList.add('bg-indigo-600', 'text-white');
          tab.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-600');

          const category = tab.dataset.category;
          items.forEach((item) => {
            item.style.display = item.dataset.categoryItem === category ? '' : 'none';
          });
        });
      });
    </script>
  </section>

  <PhotoHighlights />

  <WhyChooseUs />

  <ComparisonTable />

  <TestimonialBlock />

  <AdvicePreview />

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="mb-6 text-center text-2xl font-semibold text-slate-900">Nos villes</h2>
    <div class="flex flex-wrap justify-center gap-3">
      {
        cities.map((city) => (
          <a
            href={`/permis-accelere-${city.slug}/`}
            class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 transition-colors hover:bg-slate-50"
          >
            {city.nom}
          </a>
        ))
      }
    </div>
  </section>

  <ContactBand />

  <CtaBanner />

  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="mb-6 text-center text-2xl font-semibold text-slate-900">Questions fréquentes</h2>
    <FaqAccordion items={faqItems} />
    <p class="mt-4 text-center">
      <a href="/faq/" class="text-sm font-medium text-indigo-400 hover:underline">
        Voir toutes les questions
      </a>
    </p>
  </section>

  <FloatingContactButton />
</BaseLayout>
