---
const nomMarque = '[NOM]';
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{nomMarque} — Permis en accelere</title>
    <meta
      name="description"
      content="Reservez votre stage de permis en accelere : dates, moniteur et examen garantis avant de payer."
    />
  </head>
  <body class="bg-slate-50">
    <main class="flex min-h-screen flex-col items-center justify-center text-center">
      <h1 class="text-3xl font-bold text-slate-800">{nomMarque}</h1>
      <p class="mt-2 text-slate-500">Site vitrine en construction. Lot 1 en cours.</p>
    </main>
  </body>
</html>
