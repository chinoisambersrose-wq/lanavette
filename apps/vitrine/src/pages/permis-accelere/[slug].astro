---
import FaqAccordion from '../../components/FaqAccordion.astro';
import LeadContactForm from '../../components/LeadContactForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFormulas, getSessions } from '../../lib/api.js';
import type { Formula } from '../../lib/api.js';
import { FORMULA_IMAGE_BY_CATEGORY } from '../../lib/formulaImages.js';

export async function getStaticPaths() {
  const formulas = await getFormulas();
  return formulas.map((formula) => ({
    params: { slug: formula.slug },
    props: { formula },
  }));
}

interface Props {
  formula: Formula;
}

const { formula } = Astro.props;
const sessions = await getSessions({ formula: formula.slug });

const faqItems = [
  {
    question: `Quels sont les prérequis pour la formule ${formula.nom} ?`,
    reponse:
      "Être inscrit à l'examen du code de la route ou l'avoir déjà obtenu, selon la formule choisie.",
  },
  {
    question: 'Le moniteur est-il le même pendant tout le stage ?',
    reponse: 'Oui, un moniteur unique vous accompagne du début à la fin du stage.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: formula.nom,
    description: formula.pointsCles.join(', '),
    offers: {
      '@type': 'Offer',
      priceCurrency: 'EUR',
      price: (formula.prix / 100).toFixed(2),
      availability: 'https://schema.org/InStock',
    },
  },
];
---

<BaseLayout
  title={`${formula.nom} — Prix, durée et dates — NAVETTE`}
  description={`Stage ${formula.nom} : ${formula.dureeJours} jour(s), boîte ${formula.boite}, à partir de ${(formula.prix / 100).toFixed(0)} €. Date d'examen garantie avant paiement.`}
  structuredData={structuredData}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <img
      src={FORMULA_IMAGE_BY_CATEGORY[formula.categorie]}
      alt=""
      class="mb-6 h-56 w-full rounded-xl object-cover"
      loading="lazy"
    />
    {
      formula.badge && (
        <span class="mb-3 inline-block rounded-lg bg-indigo-600 px-3 py-1 text-sm text-white">
          {formula.badge}
        </span>
      )
    }
    <h1 class="text-3xl font-semibold text-white">{formula.nom}</h1>
    <p class="mt-2 text-slate-300">
      Boîte {formula.boite} · {formula.dureeJours} jour(s)
      {formula.heuresConduite ? ` · ${formula.heuresConduite}h de conduite` : ''}
    </p>

    <div class="mt-6 flex items-end gap-4">
      <p class="text-4xl font-semibold text-white">{(formula.prix / 100).toFixed(0)} €</p>
      {
        formula.mensualiteAffichee && (
          <p class="text-slate-400">
            ou dès {(formula.mensualiteAffichee / 100).toFixed(0)} €/mois
          </p>
        )
      }
    </div>

    <h2 class="mt-10 text-xl font-semibold text-white">Dates disponibles</h2>
    {
      sessions.length > 0 ? (
        <div class="mt-4 space-y-3">
          {sessions.map((session) => {
            const premierJour = new Date(session.dates[0]?.jour ?? '');
            const dernierJour = new Date(session.dates.at(-1)?.jour ?? '');
            const periode = `du ${premierJour.toLocaleDateString('fr-FR')} au ${dernierJour.toLocaleDateString('fr-FR')}`;
            return (
              <div class="rounded-xl border border-slate-800 bg-slate-900 p-4">
                <p class="font-medium text-white">{periode}</p>
                <p class="text-sm text-slate-400">
                  {session.meetingPointId.nom} · {session.placesRestantes} place(s) restante(s)
                </p>
                <LeadContactForm
                  message={`Je suis intéressé(e) par la formule ${formula.nom}, session ${periode} (${session.meetingPointId.nom}).`}
                  class="mt-3"
                />
              </div>
            );
          })}
        </div>
      ) : (
        <div class="mt-4 rounded-xl border border-slate-800 bg-slate-900 p-4">
          <p class="text-slate-300">
            Aucune date en ligne pour le moment — contactez-nous pour connaître les prochaines
            sessions.
          </p>
          <LeadContactForm
            message={`Je suis intéressé(e) par la formule ${formula.nom}. Quelles sont les prochaines dates disponibles ?`}
            class="mt-3"
          />
        </div>
      )
    }

    <h2 class="mt-10 text-xl font-semibold text-white">Ce qui est inclus</h2>
    <ul class="mt-3 space-y-2 text-slate-300">
      {formula.pointsCles.map((point) => <li>• {point}</li>)}
    </ul>

    <h2 class="mt-10 text-xl font-semibold text-white">Questions fréquentes</h2>
    <div class="mt-3">
      <FaqAccordion items={faqItems} />
    </div>
  </section>
</BaseLayout>
