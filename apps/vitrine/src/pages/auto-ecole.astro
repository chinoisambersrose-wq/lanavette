---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCities, getMeetingPoints } from '../lib/api.js';

const cities = await getCities();
const meetingPointsByCity = await Promise.all(
  cities.map(async (city) => ({ city, points: await getMeetingPoints(city.slug) })),
);
---

<BaseLayout
  title="Nos agences et points de rendez-vous — NAVETTE"
  description="Retrouvez toutes nos agences et points de rendez-vous par ville."
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <img
      src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=60"
      alt=""
      class="mb-6 h-56 w-full rounded-xl object-cover"
      loading="lazy"
    />
    <h1 class="text-3xl font-semibold text-white">Nos agences</h1>
    <p class="mt-2 text-sm text-slate-500">
      Carte interactive à venir (nécessite une clé Mapbox ou Google Maps) — liste des points de
      RDV en attendant.
    </p>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        meetingPointsByCity.map(({ city, points }) => (
          <div>
            <h2 class="mb-2 text-lg font-semibold text-white">{city.nom}</h2>
            {points.length > 0 ? (
              <ul class="space-y-2">
                {points.map((point) => (
                  <li class="rounded-lg border border-slate-800 bg-slate-900 p-3 text-sm">
                    <p class="font-medium text-white">{point.nom}</p>
                    <p class="text-slate-300">{point.adresse}</p>
                    <p class="text-slate-500">Boîte : {point.boites.join(', ')}</p>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-slate-400">Aucun point de RDV pour le moment.</p>
            )}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
