---
export type IconName = 'calendar' | 'star' | 'rocket' | 'users' | 'shield' | 'clock' | 'message' | 'phone' | 'menu' | 'close';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

{
  name === 'calendar' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className} aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 9h18M8 3v4M16 3v4" stroke-linecap="round" />
      <path d="M8.5 14.5l2 2 4.5-4.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'star' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M12 3.5l2.47 5.18 5.53.63-4.1 3.9 1.1 5.6L12 15.9l-5 2.91 1.1-5.6-4.1-3.9 5.53-.63z" />
    </svg>
  )
}
{
  name === 'rocket' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M12 3c2.5 2 4 5.5 4 9 0 1.8-.4 3.2-1 4.3L12 18l-3-1.7c-.6-1.1-1-2.5-1-4.3 0-3.5 1.5-7 4-9z" />
      <circle cx="12" cy="10" r="1.4" />
      <path d="M9 15.5l-2 3.5M15 15.5l2 3.5M10 18.5v2.5M14 18.5v2.5" />
    </svg>
  )
}
{
  name === 'users' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <circle cx="9" cy="8" r="3" />
      <path d="M3.5 19c.8-3 2.9-4.5 5.5-4.5s4.7 1.5 5.5 4.5" />
      <circle cx="17" cy="8.5" r="2.2" />
      <path d="M15.5 14.8c2 .2 3.5 1.6 4.1 4.2" />
    </svg>
  )
}
{
  name === 'shield' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6z" />
      <path d="M9 12l2 2 4-4" />
    </svg>
  )
}
{
  name === 'clock' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </svg>
  )
}
{
  name === 'message' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M4 5h16v10H9l-4 4V5z" />
    </svg>
  )
}
{
  name === 'phone' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M5 4h3.5l1.5 4.5-2 1.5a11 11 0 0 0 5.5 5.5l1.5-2 4.5 1.5V18c0 1.1-.9 2-2 2C9.5 20 4 14.5 4 7.5c0-1.1.9-2 2-2z" />
    </svg>
  )
}
{
  name === 'menu' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class={className} aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  )
}
{
  name === 'close' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class={className} aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  )
}
