---
// Avis [DEMO] : donnees fictives pour le developpement, a remplacer par de vrais avis clients
// collectes apres l'examen (voir CLAUDE.md, section "Contenus et originalite").
const testimonials = [
  {
    prenom: 'Lucie [DEMO]',
    note: 5,
    texte: '[DEMO] Stage intensif et moniteur a l\'ecoute, j\'ai pu passer mon examen rapidement.',
  },
  {
    prenom: 'Karim [DEMO]',
    note: 4,
    texte: '[DEMO] Organisation claire, dates connues a l\'avance, ca change tout pour planifier.',
  },
  {
    prenom: 'Sofia [DEMO]',
    note: 5,
    texte: '[DEMO] Equipe reactive, process simple du debut a la fin.',
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="mb-2 text-center text-2xl font-semibold text-white">Ils nous font confiance</h2>
  <p class="mb-8 text-center text-xs text-slate-500">
    Avis de démonstration — à remplacer par de vrais avis clients vérifiés.
  </p>

  <div class="grid gap-4 md:grid-cols-3">
    {
      testimonials.map((t) => (
        <blockquote class="rounded-xl border border-slate-800 bg-slate-900 p-5">
          <div class="flex gap-0.5" aria-hidden="true">
            {Array.from({ length: 5 }, (_, i) => (
              <svg
                viewBox="0 0 20 20"
                class={`h-4 w-4 ${i < t.note ? 'fill-amber-400' : 'fill-slate-700'}`}
              >
                <path d="M10 1.5l2.47 5.18 5.53.63-4.1 3.9 1.1 5.6L10 13.9l-5 2.91 1.1-5.6-4.1-3.9 5.53-.63z" />
              </svg>
            ))}
          </div>
          <p class="mt-3 text-sm text-slate-300">{t.texte}</p>
          <p class="mt-3 text-sm font-medium text-white">{t.prenom}</p>
        </blockquote>
      ))
    }
  </div>
</section>
