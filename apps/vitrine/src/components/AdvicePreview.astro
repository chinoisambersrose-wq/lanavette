---
import { getCollection } from 'astro:content';
import Icon, { type IconName } from './Icon.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const iconByCategory: Record<string, IconName> = {
  'Choix de formule': 'shield',
  Financement: 'calendar',
  'Idées reçues': 'message',
};
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="mb-6 text-center text-2xl font-semibold text-white">
    Nos conseils pour réussir votre permis
  </h2>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {
      posts.map((post) => (
        <article class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900">
          <div class="flex h-36 items-center justify-center bg-gradient-to-br from-indigo-600/20 to-slate-800">
            <Icon
              name={iconByCategory[post.data.category] ?? 'message'}
              class="h-10 w-10 text-indigo-400"
            />
          </div>
          <div class="p-5">
            <p class="text-sm font-medium text-indigo-400">{post.data.category}</p>
            <a href={`/blog/${post.slug}/`} class="mt-1 block font-semibold text-white hover:underline">
              {post.data.title}
            </a>
            <p class="mt-2 text-sm text-slate-400">{post.data.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
