---
import ContactButtons from './ContactButtons.astro';
import Icon from './Icon.astro';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_TEL } from '../lib/contact.js';

const APP_URL = import.meta.env.APP_URL ?? 'http://localhost:5173';

interface NavItem {
  href: string;
  label: string;
  children?: Array<{ href: string; label: string }>;
}

const links: NavItem[] = [
  {
    href: '/permis-b-accelere/',
    label: 'Permis B accéléré',
    children: [
      { href: '/permis-b-accelere/#stages', label: 'Nos stages accélérés' },
      { href: '/permis-automatique/', label: 'Permis boîte automatique' },
      { href: '/methode/', label: 'Notre méthode' },
      { href: '/permis-b-accelere/#examen', label: 'Examen permis B' },
      { href: '/permis-b-accelere/#aac', label: 'Conduite accompagnée' },
    ],
  },
  {
    href: '/permis-moto-accelere/',
    label: 'Permis moto accéléré',
    children: [
      { href: '/permis-moto-accelere/#tout-savoir', label: 'Permis moto : tout savoir' },
      { href: '/permis-moto-accelere/#accelere', label: 'Permis moto accéléré' },
      { href: '/permis-moto-accelere/#villes', label: 'Où passer son permis moto' },
      { href: '/permis-moto-accelere/#permis-a2', label: 'Permis A2' },
    ],
  },
  {
    href: '/permis-poids-lourds/',
    label: 'Permis poids lourds',
    children: [
      { href: '/permis-poids-lourds/#tout-savoir', label: 'Permis poids lourds : tout savoir' },
      { href: '/permis-poids-lourds/#stages', label: 'Nos stages accélérés' },
      { href: '/permis-poids-lourds/#villes', label: 'Où passer son permis' },
      { href: '/permis-poids-lourds/#fimo-fco', label: 'FIMO et FCO' },
    ],
  },
  {
    href: '/financement/',
    label: 'Financement',
    children: [
      { href: '/financement/#tous-les-financements', label: 'Tous les financements' },
      { href: '/financement/#cpf', label: 'CPF et co-financement' },
      { href: '/financement/#plusieurs-fois', label: 'Payer en plusieurs fois' },
      { href: '/financement/#dix-fois', label: 'Paiement en 10 fois' },
    ],
  },
  { href: '/permis-accelere/', label: 'Toutes les formules' },
  { href: '/blog/', label: 'Blog' },
  { href: '/faq/', label: 'FAQ' },
];
---

<header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href="/" class="text-xl font-semibold tracking-tight text-white">NAVETTE</a>

    <nav class="hidden items-center gap-5 text-sm text-slate-300 lg:flex">
      {
        links.map((link) =>
          link.children ? (
            <div class="group relative">
              <a href={link.href} class="flex items-center gap-1 py-2 transition-colors hover:text-white">
                {link.label}
                <svg viewBox="0 0 20 20" class="h-3.5 w-3.5 fill-current" aria-hidden="true">
                  <path d="M5.5 7.5l4.5 4.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <div class="invisible absolute left-0 top-full min-w-[15rem] rounded-xl border border-slate-800 bg-slate-900 p-2 opacity-0 shadow-lg transition-opacity group-hover:visible group-hover:opacity-100">
                {
                  link.children.map((child) => (
                    <a
                      href={child.href}
                      class="block rounded-lg px-3 py-2 text-sm text-slate-300 transition-colors hover:bg-slate-800 hover:text-white"
                    >
                      {child.label}
                    </a>
                  ))
                }
              </div>
            </div>
          ) : (
            <a href={link.href} class="transition-colors hover:text-white">
              {link.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={`${APP_URL}/login`}
        class="text-sm text-slate-300 transition-colors hover:text-white"
      >
        Connexion
      </a>
      <ContactButtons message="Bonjour, je souhaite m'inscrire à un stage de permis accéléré NAVETTE." />
    </div>

    <div class="flex items-center gap-4 lg:hidden">
      <a
        href={`tel:${CONTACT_PHONE_TEL}`}
        class="flex items-center gap-1.5 text-sm text-slate-200 transition-colors hover:text-white"
      >
        <Icon name="phone" class="h-4 w-4" />
        <span class="whitespace-nowrap">{CONTACT_PHONE_DISPLAY}</span>
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        class="text-slate-200 hover:text-white"
      >
        <span id="mobile-menu-icon-open"><Icon name="menu" class="h-6 w-6" /></span>
        <span id="mobile-menu-icon-close" class="hidden"><Icon name="close" class="h-6 w-6" /></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden max-h-[calc(100vh-57px)] overflow-y-auto border-t border-slate-800 bg-slate-950 px-4 py-4 lg:hidden"
  >
    {
      links.map((link) => (
        <div class="border-b border-slate-800 py-2 last:border-none">
          <a href={link.href} class="block py-1.5 font-medium text-white">
            {link.label}
          </a>
          {link.children && (
            <div class="ml-3 flex flex-col">
              {link.children.map((child) => (
                <a href={child.href} class="py-1.5 text-sm text-slate-400 hover:text-white">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))
    }
    <a href={`${APP_URL}/login`} class="block py-3 font-medium text-white">
      Connexion
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('mobile-menu-icon-open');
  const iconClose = document.getElementById('mobile-menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
