---
import Icon from './Icon.astro';

const stats = [
  { icon: 'calendar', value: '100%', label: 'des dates et du moniteur connus avant paiement' },
  { icon: 'rocket', value: '1 200+', label: 'stages réalisés' },
  { icon: 'star', value: '4,6/5', label: 'note moyenne des stagiaires' },
  { icon: 'users', value: '89%', label: 'recommandent NAVETTE' },
] as const;
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
    {
      stats.map((stat) => (
        <div class="flex flex-col items-center text-center">
          <Icon name={stat.icon} class="h-7 w-7 text-slate-500" />
          <p class="mt-3 text-2xl font-semibold text-indigo-400 md:text-3xl">{stat.value}</p>
          <p class="mt-1 text-sm text-slate-400">
            {stat.label}
          </p>
        </div>
      ))
    }
  </div>
</section>
