---
// Stats [DEMO] (sauf la 1ere, qui decrit une regle metier reelle du produit) : a remplacer par
// de vraies statistiques des que disponibles (voir CLAUDE.md, section "Contenus et originalite").
import Icon from './Icon.astro';

const stats = [
  { icon: 'calendar', value: '100%', label: 'des dates et du moniteur connus avant paiement', demo: false },
  { icon: 'rocket', value: '1 200+', label: 'stages réalisés', demo: true },
  { icon: 'star', value: '4,6/5', label: 'note moyenne des stagiaires', demo: true },
  { icon: 'users', value: '89%', label: 'recommandent NAVETTE', demo: true },
] as const;
---

<section class="mx-auto max-w-6xl px-4 py-12">
  <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
    {
      stats.map((stat) => (
        <div class="flex flex-col items-center text-center">
          <Icon name={stat.icon} class="h-8 w-8 text-indigo-600" />
          <p class="mt-3 text-2xl font-bold text-slate-900 md:text-3xl">
            {stat.demo && <span class="mr-1 text-xs font-normal text-slate-400">[DEMO]</span>}
            {stat.value}
          </p>
          <p class="mt-1 text-sm text-slate-500">{stat.label}</p>
        </div>
      ))
    }
  </div>
  <p class="mt-6 text-center text-xs text-slate-400">
    Chiffres de démonstration — à remplacer par de vraies statistiques mesurées.
  </p>
</section>
