---
import 'leaflet/dist/leaflet.css';
import type { City } from '../lib/api.js';
import { CITY_COORDINATES } from '../lib/cityCoordinates.js';

interface Props {
  cities: City[];
}

const { cities } = Astro.props;

const markers = cities
  .filter((city) => CITY_COORDINATES[city.slug])
  .map((city) => ({
    nom: city.nom,
    slug: city.slug,
    coords: CITY_COORDINATES[city.slug],
  }));
---

<div id="cities-map" class="h-[500px] w-full rounded-xl border border-slate-800" data-markers={JSON.stringify(markers)}></div>

<script>
  import L from 'leaflet';

  const container = document.getElementById('cities-map');
  if (container) {
    const markers = JSON.parse(container.dataset.markers ?? '[]') as Array<{
      nom: string;
      slug: string;
      coords: [number, number];
    }>;

    const map = L.map(container).setView([46.6, 2.5], 6);

    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      maxZoom: 19,
    }).addTo(map);

    for (const { nom, slug, coords } of markers) {
      L.marker(coords)
        .addTo(map)
        .bindPopup(`<a href="/permis-accelere-${slug}/" style="color:#1d4ed8;">${nom}</a>`);
    }
  }
</script>
