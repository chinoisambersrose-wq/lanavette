---
import ContactButtons from './ContactButtons.astro';

const points = [
  'Dates et moniteur connus avant de payer',
  "Date d'examen garantie",
  'Paiement en plusieurs fois disponible',
];
---

<section
  class="relative overflow-hidden bg-cover bg-center px-6 py-16 text-center text-white"
  style="background-image: url('/hero.jpg');"
>
  <div class="absolute inset-0 bg-slate-950/70" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-2xl">
    <h2 class="text-2xl font-semibold md:text-3xl">Prêt à embarquer avec NAVETTE ?</h2>
    <p class="mt-2 text-slate-200">
      Choisissez votre formule, votre moniteur et votre date d'examen avant de payer.
    </p>

    <ul class="mx-auto mt-5 flex max-w-xl flex-col flex-wrap items-center gap-2 text-sm text-slate-100 sm:flex-row sm:justify-center">
      {
        points.map((point) => (
          <li class="flex items-center gap-1.5">
            <span aria-hidden="true">✓</span>
            {point}
          </li>
        ))
      }
    </ul>

    <ContactButtons
      message="Bonjour, je souhaite m'inscrire à un stage de permis accéléré NAVETTE."
      size="lg"
      class="mt-6 justify-center"
    />
  </div>
</section>
