---
// Adresse de contact placeholder, a remplacer des que le domaine definitif sera choisi (Lot 0).
const CONTACT_EMAIL = 'contact@navette.exemple';
---

<section class="mx-auto max-w-4xl px-4 py-12 text-center">
  <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">
    Besoin d'être accompagné ?
  </p>
  <h2 class="mt-2 text-2xl font-bold text-slate-800">On vous aide à choisir votre stage</h2>
  <p class="mx-auto mt-3 max-w-xl text-slate-600">
    Une question sur une formule, un délai ou un mode de paiement ? Notre équipe vous répond
    rapidement.
  </p>
  <a
    href={`mailto:${CONTACT_EMAIL}`}
    class="mt-5 inline-block rounded-full bg-slate-900 px-6 py-3 text-sm font-medium text-white hover:bg-slate-700"
  >
    Contactez-nous
  </a>
</section>
