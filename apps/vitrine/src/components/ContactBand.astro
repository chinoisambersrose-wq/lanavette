---
// Adresse de contact placeholder, a remplacer des que le domaine definitif sera choisi (Lot 0).
const CONTACT_EMAIL = 'contact@navette.exemple';
---

<section class="mx-auto max-w-4xl px-4 py-16 text-center">
  <p class="text-sm font-medium text-indigo-400">Besoin d'être accompagné ?</p>
  <h2 class="mt-2 text-2xl font-semibold text-white">On vous aide à choisir votre stage</h2>
  <p class="mx-auto mt-3 max-w-xl text-slate-300">
    Une question sur une formule, un délai ou un mode de paiement ? Notre équipe vous répond
    rapidement.
  </p>
  <a
    href={`mailto:${CONTACT_EMAIL}`}
    class="mt-5 inline-block rounded-lg bg-white px-6 py-3 text-sm font-medium text-slate-900 transition-colors hover:bg-slate-200"
  >
    Contactez-nous
  </a>
</section>
