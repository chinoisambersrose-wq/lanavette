{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npm run build -w packages/shared && npm run build -w apps/app",
  "installCommand": "cd ../.. && npm ci --ignore-scripts",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://109.199.118.66:4100/api/v1/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
