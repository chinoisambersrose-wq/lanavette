# Memes variables que apps/api/.env.example, avec des valeurs de PRODUCTION :
# - MONGODB_URI : cluster MongoDB Atlas (region UE), utilisateur dedie, IP du VPS autorisee
# - JWT_*_SECRET : secrets forts et uniques, differents de ceux de dev/preprod
# - STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET : cles LIVE (jamais les cles de test)
# - APP_ORIGIN / VITRINE_ORIGIN : domaines Vercel de production (apps.exemple.fr, www.exemple.fr)
# - S3_* : bucket Cloudflare R2 ou S3 de production
# - RESEND_* : compte Resend reel pour les emails (sinon journalisees seulement)
# - BREVO_* : compte Brevo reel pour les SMS (sinon journalises seulement)
#
# Copier ce fichier en `.env` a cote de docker-compose.yml sur le VPS (jamais commite).

NODE_ENV=production
PORT=4000

MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

APP_ORIGIN=
VITRINE_ORIGIN=
VITRINE_DEPLOY_HOOK_URL=

BOOKING_HOLD_DURATION_MINUTES=15
BOOKING_EXPIRATION_CRON=*/1 * * * *
CANCELLATION_FREE_DAYS_BEFORE_START=7

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

ALMA_ENABLED=false

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=

BREVO_API_KEY=
BREVO_SMS_SENDER=
